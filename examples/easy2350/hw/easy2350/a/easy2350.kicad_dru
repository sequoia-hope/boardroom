(version 1)

# VBUS carries 0.5 A, 0.75 A peak (design/nets.csv). IPC-2221, outer 1 oz,
# 10 C rise: 0.75 A needs 11 mil2, 0.20 mm wide. No neck below it, even at a pad.
(rule "VBUS current width"
  (condition "A.NetName == 'VBUS'")
  (constraint track_width (min 0.2mm)))

# The regulator corner (chips/rp2350.md): under L1's body no copper but the
# regulator's own, VREG_LX from U1 pin 48 and 1V1 out to C15. The area is a
# rule area board.py's zones stage draws round L1's courtyard (+0.15 mm).
(rule "regulator corner: its own nets only"
  (condition "A.intersectsArea('plane regulator corner') && A.NetName != '/VREG_LX' && A.NetName != '+1V1'")
  (constraint disallow track via))

# Inside U1's pad ring (chips/rp2350.md: no foreign net crosses it): the
# exposed GND pad, and the 1V1 and 3V3 copper that feeds the core pins.
(rule "U1 pad ring: power nets only"
  (condition "A.intersectsArea('plane U1 ring') && A.NetName != 'GND' && A.NetName != '+1V1' && A.NetName != '+3V3'")
  (constraint disallow track via))

# Length limits from design/nets.csv (length_limit), and no vias where its reason
# says so. KiCad DRC enforces them, so autoroute.py's judge passes over a seed
# that breaks one (QSPI_SD0 once ran 27.5 mm of 25).
(rule "VREG_LX length"
  (condition "A.NetName == '/VREG_LX'")
  (constraint length (max 5mm)))
(rule "VREG_AVDD length"
  (condition "A.NetName == '/VREG_AVDD'")
  (constraint length (max 10mm)))
(rule "USB_DP_C length"
  (condition "A.NetName == '/USB_DP_C'")
  (constraint length (max 20mm)))
(rule "USB_DM_C length"
  (condition "A.NetName == '/USB_DM_C'")
  (constraint length (max 20mm)))
(rule "USB_DP length"
  (condition "A.NetName == '/USB_DP'")
  (constraint length (max 20mm)))
(rule "USB_DM length"
  (condition "A.NetName == '/USB_DM'")
  (constraint length (max 20mm)))
(rule "USB_DP_MCU length"
  (condition "A.NetName == '/USB_DP_MCU'")
  (constraint length (max 5mm)))
(rule "USB_DM_MCU length"
  (condition "A.NetName == '/USB_DM_MCU'")
  (constraint length (max 5mm)))
(rule "QSPI_SCLK length"
  (condition "A.NetName == '/QSPI_SCLK'")
  (constraint length (max 25mm)))
(rule "QSPI_SD0 length"
  (condition "A.NetName == '/QSPI_SD0'")
  (constraint length (max 25mm)))
(rule "QSPI_SD1 length"
  (condition "A.NetName == '/QSPI_SD1'")
  (constraint length (max 25mm)))
(rule "QSPI_SD2 length"
  (condition "A.NetName == '/QSPI_SD2'")
  (constraint length (max 25mm)))
(rule "QSPI_SD3 length"
  (condition "A.NetName == '/QSPI_SD3'")
  (constraint length (max 25mm)))
(rule "QSPI_SS length"
  (condition "A.NetName == '/QSPI_SS'")
  (constraint length (max 25mm)))
(rule "XIN length"
  (condition "A.NetName == '/XIN'")
  (constraint length (max 10mm)))
(rule "XIN no vias"
  (condition "A.NetName == '/XIN'")
  (constraint via_count (max 0)))
(rule "XOUT length"
  (condition "A.NetName == '/XOUT'")
  (constraint length (max 5mm)))
(rule "XOUT_R length"
  (condition "A.NetName == '/XOUT_R'")
  (constraint length (max 5mm)))

# No via hole in or at an SMD pad (review-layout 2026-10-31 M1): an open hole in
# a reflow pad wicks paste, and on a 0.4 mm QFN pad the via is wider than the
# pad. The exposed pads of U1 and U3 take their thermal vias. 0.2 mm, so the
# 0.15 mm ring clears the pad too and the mask keeps a dam (review 2 B1).
(rule "no via hole in an SMD pad"
  (condition "A.Type == 'Via' && B.Type == 'Pad' && B.Pad_Type == 'SMD' && (B.existsOnLayer('F.Cu') || B.existsOnLayer('B.Cu')) && !(B.memberOfFootprint('U1') && B.Pad_Number == '61') && !(B.memberOfFootprint('U3') && B.Pad_Number == '9')")
  (constraint physical_hole_clearance (min 0.2mm)))

# The crystal (review-layout M2: PIX12 ran between Y1's pads): under Y1 and
# 0.5 mm round it, only its own nets. The area is board.py's rule area round
# Y1's courtyard.
(rule "crystal: its own nets only"
  (condition "A.intersectsArea('plane crystal') && A.NetName != '/XIN' && A.NetName != '/XOUT_R' && A.NetName != 'GND'")
  (constraint disallow track via))

# The regulator's analog supply stays on the top, beside the corner, as the
# reference runs it; not under the switch node on L4 (review 2 B2).
(rule "VREG_AVDD no vias"
  (condition "A.NetName == '/VREG_AVDD'")
  (constraint via_count (max 0)))
